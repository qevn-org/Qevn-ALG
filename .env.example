# LLM
OPENAI_API_KEY=

# Apify
APIFY_TOKEN=

# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=linkedin-multi-agent

# Runtime
APP_ENV=development
LOG_LEVEL=INFO

# Model
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Limits
MAX_SEARCH_QUERIES=20
MAX_RESULTS_PER_RUN=500
MAX_DEEP_RESEARCH_ITEMS=25
